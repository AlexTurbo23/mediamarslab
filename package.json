{
  "name": "picsio-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript end-to-end and API test automation for qa-a.recruitment.mediamarslab.com",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:line": "playwright test --reporter=line",
    "test:debug": "playwright test --debug",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results --clean && allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.53.1",
    "@types/node": "^22.15.30",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.3.3",
    "dotenv": "^16.5.0",
    "eslint": "^9.29.0",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "zod": "^4.4.3"
  }
}
